# The Streamlit dashboard, reading Azure SQL.
#
# Plan Step 10. Runs as a Container App with the h1b-web managed identity, which
# holds db_datareader and nothing else — the dashboard cannot write even if a
# query tried.
#
#   docker build -f Dockerfile.web -t ghcr.io/justinrheydavid/h-1b-tech-salary-explore-web:latest .
#
# GHCR paths must be lowercase; the repository's own capitalization does not
# survive into the image name.

FROM python:3.11-slim-bookworm

# The Microsoft ODBC driver. pyodbc is a binding, not a driver: pip installs it
# happily and then every connection fails with "Can't open lib 'ODBC Driver 18
# for SQL Server'", which reads like a missing Python package and is not one.
#
# **The base tag is pinned to bookworm, and that is the whole point.** This
# comment used to say "Debian 12 (bookworm) is what python:3.11-slim is built
# on". That stopped being true: the tag moved to Debian 13 (trixie), and the
# image kept adding the Debian 12 Microsoft repository to it. The apt lists
# recovered from the shipped image name trixie; `mssql.list` named bookworm.
# Pinning the tag makes the sentence above true again and stops it drifting a
# second time, which an unpinned `python:3.11-slim` guarantees it eventually
# will.
#
# `libgssapi-krb5-2` is named explicitly even though it is a dependency of the
# driver, because it is the one apt does not protect. It arrives as an
# auto-installed dependency of curl; msodbcsql18 links against
# `libgssapi_krb5.so.2` at runtime without declaring it; so `purge curl` +
# `autoremove` takes it away and nothing objects. Naming it here marks it
# manually installed, which autoremove will not touch. Its three siblings
# (libkrb5-3, libk5crypto3, libkrb5support0) survived on their own — that
# asymmetry is exactly why this was invisible.
#
# **Then check, rather than trust.** Both images shipped and deployed with a
# driver that could not load, and nothing noticed: the ETL job failed after two
# minutes of work and the dashboard served a 200 with an error banner inside it,
# which the deployment's own health check cannot see. `ldd` reads the same
# NEEDED entries the dynamic loader will, so a missing library fails the build
# here instead of the deployment there.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg unixodbc \
 && curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql.list \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 libgssapi-krb5-2 \
 && apt-get purge -y curl gnupg \
 && apt-get autoremove -y \
 && ldd /opt/microsoft/msodbcsql18/lib64/libmsodbcsql-*.so.* > /tmp/driver-ldd.txt \
 && if grep -q 'not found' /tmp/driver-ldd.txt; then \
      echo 'the ODBC driver has unmet shared-library dependencies:'; \
      grep 'not found' /tmp/driver-ldd.txt; exit 1; \
    fi \
 && rm -f /tmp/driver-ldd.txt \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# One requirements.txt, installed whole — the same call Dockerfile.etl makes,
# for the same reason: a second pinned list is a second thing to keep in step.
#
# It costs more here than there, because this image cold-starts in front of a
# person while the job's pull cost lands on nobody. openpyxl, pyarrow and
# azure-storage-blob are never imported on this path — `src.load` only pulls
# `ingest` inside `build()`, which the dashboard never calls. **If the 30-second
# cold-start budget is missed, splitting them out is the first lever to try**,
# and the second is that the driver install above is most of the image.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .
COPY src/ ./src/
# The theme from the end of Phase 1. Without it the page renders in Streamlit's
# default colours and looks like a different application.
COPY .streamlit/ ./.streamlit/

# Unbuffered so Container Apps' log stream shows a failure as it happens rather
# than when the process finally exits.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DB_BACKEND=azure

# Declared here as well as on the container app. If this image is ever run
# without DB_BACKEND set, defaulting to sqlite would make it look for a database
# file that this image deliberately does not carry, and the dashboard would
# report a missing file rather than an unconfigured backend.

RUN useradd --create-home --uid 10001 web
USER web

EXPOSE 8501

# Streamlit's own health endpoint, which the container app's probe also uses.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=4).status == 200 else 1)"

# --server.address=0.0.0.0 because the default binds localhost, which is
# unreachable from outside the container and produces a container that starts
# cleanly and answers nothing.
CMD ["streamlit", "run", "app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
