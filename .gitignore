# --- Data ---------------------------------------------------------------
# Raw DOL downloads are 100-200 MB each and must never be committed.
data/raw/*
!data/raw/.gitkeep

# Source spreadsheets, wherever they land.
*.xlsx
*.xls

# Intermediate Parquet cache - rebuildable from raw, so not tracked.
data/interim/

# The built SQLite database IS committed on purpose: the deployed
# Streamlit app reads it directly from the repo. Do not ignore it.
!data/h1b.db

# SQLite's rollback journal, and any scratch database. The journal only exists
# mid-write; committing one would ship a half-finished transaction.
*.db-journal
*.db-wal
data/probe.db

# Scratch files from the atomic writes in load.py and ingest.py. Normally
# deleted on the way out, but a hard kill strands one — and load.py's is a
# near-complete copy of the 78 MB database, sitting right next to it in data/.
*.tmp

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*

# --- Secrets ------------------------------------------------------------
.env
.streamlit/secrets.toml
